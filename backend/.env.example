# Copy these into your shell / IntelliJ run configuration. Never commit real values.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
DB_URL=jdbc:mysql://localhost:3306/phishmenot?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your-mysql-password
FRONTEND_URL=http://localhost:5173
# Optional: Google emails that become ADMIN when their account is first created
ADMIN_EMAILS=
COOKIE_SECURE=false
# Optional: SMTP for password reset emails (Gmail: smtp.gmail.com, 587, your address, an App Password)
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
# Only when using MariaDB instead of MySQL:
# SPRING_JPA_DATABASEPLATFORM=org.hibernate.dialect.MariaDBDialect
